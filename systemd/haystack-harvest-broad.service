[Unit]
Description=haystack: weekly broad harvest (seeds stratified over the listener's genres, ADR 0013)
Documentation=https://github.com/kurtlieber/haystack#readme
Wants=network-online.target
After=network-online.target
OnFailure=haystack-alert@%n.service

[Service]
Type=oneshot
ExecStart=%h/.local/share/haystack/venv/bin/haystack harvest --broad 150
Environment=PYTHONUNBUFFERED=1 TF_CPP_MIN_LOG_LEVEL=3
Nice=19
IOSchedulingClass=idle
MemoryHigh=8G
TimeoutStartSec=8h
SyslogIdentifier=haystack-harvest-broad
